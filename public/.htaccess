# ============================================================
# MONKAURA — Production Routing for Hostinger Business Web Hosting
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Optional: Proxy /api/* to Node.js backend if running on port 3000
    # RewriteRule ^api/?$ http://127.0.0.1:3000/api [P,L]
    # RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

    # If the requested path is an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If the directory has an index.html (from static prerendering), serve it
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ /$1/index.html [L]

    # Otherwise fallback to root index.html for client-side routing
    RewriteRule ^ index.html [L]
</IfModule>

# Caching and Security Headers
<IfModule mod_headers.c>
    # Cache static assets (images, CSS, JS) for 1 month
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|ttf)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Never cache HTML files or XML sitemaps so updates are immediately visible
    <FilesMatch "\.(html|xml|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Basic security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
