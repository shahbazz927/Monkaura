# OPENROUTER_API_KEY: Required for OpenRouter AI API calls (recipe generation).
# Get your key at https://openrouter.ai/keys
# NEVER commit a real API key. Copy this file to .env and add your key there.
# On Hostinger Node.js hosting, set this in hPanel → Node.js → yourapp → Settings
# (or in a Hostinger ".env" file in the app root).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://monkaura.in

# PORT: The port the Express server listens on.
# Defaults to 3000 when unset. Hostinger Node.js hosting AUTO-INJECTS a port,
# so leave this unset on Hostinger. If you edit public/.htaccess to proxy
# /api/* to 127.0.0.1:PORT, keep this and the .htaccess port in sync.
# PORT=3000